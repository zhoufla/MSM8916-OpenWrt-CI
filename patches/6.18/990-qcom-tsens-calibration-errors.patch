Subject: [PATCH] thermal: qcom: tsens: preserve MSM8916 calibration errors

Select per-cell calibration explicitly when the firmware declares "mode".
Keep its original errors, including -EPROBE_DEFER, instead of replacing
them with a failed legacy "calib" lookup. Report the failing cell name.

Keep init_common() outside init memory so a later probe does not call
freed code. This part follows the upstream patch posted at:
https://lore.kernel.org/r/20261104145740.2623473-2-opensource@grische.xyz

The original calibration failure still needs hardware validation; this
patch does not bypass calibration or alter calibration values.

--- a/drivers/thermal/qcom/tsens-v0_1.c
+++ b/drivers/thermal/qcom/tsens-v0_1.c
@@ -5,6 +5,7 @@
 
 #include <linux/bitfield.h>
 #include <linux/nvmem-consumer.h>
+#include <linux/of.h>
 #include <linux/platform_device.h>
 #include "tsens.h"
 
@@ -87,11 +88,12 @@
 {
 	u32 p1[5], p2[5];
 	u32 *qfprom_cdata, *qfprom_csel;
-	int mode, ret;
-
-	ret = tsens_calibrate_nvmem(priv, 3);
-	if (!ret)
-		return 0;
+	int mode;
+
+	/* Do not hide per-cell errors (including probe deferral) with a legacy fallback. */
+	if (of_property_match_string(priv->dev->of_node,
+				     "nvmem-cell-names", "mode") >= 0)
+		return tsens_calibrate_nvmem(priv, 3);
 
 	qfprom_cdata = (u32 *)qfprom_read(priv->dev, "calib");
 	if (IS_ERR(qfprom_cdata))
--- a/drivers/thermal/qcom/tsens.c
+++ b/drivers/thermal/qcom/tsens.c
@@ -86,8 +86,12 @@
 		return ret;
 
 	ret = nvmem_cell_read_variable_le_u32(priv->dev, name, &mode);
-	if (ret == -ENOENT)
+	if (ret == -ENOENT &&
+	    of_property_match_string(priv->dev->of_node, "nvmem-cell-names", name) < 0)
 		dev_warn(priv->dev, "Please migrate to separate nvmem cells for calibration data\n");
+	else if (ret < 0)
+		return dev_err_probe(priv->dev, ret,
+				     "failed to read calibration cell %s\n", name);
 	if (ret < 0)
 		return ret;
 
@@ -99,7 +103,8 @@
 
 	ret = nvmem_cell_read_variable_le_u32(priv->dev, name, &base1);
 	if (ret < 0)
-		return ret;
+		return dev_err_probe(priv->dev, ret,
+				     "failed to read calibration cell %s\n", name);
 
 	ret = snprintf(name, sizeof(name), "base2%s", backup ? "_backup" : "");
 	if (ret < 0)
@@ -107,7 +112,8 @@
 
 	ret = nvmem_cell_read_variable_le_u32(priv->dev, name, &base2);
 	if (ret < 0)
-		return ret;
+		return dev_err_probe(priv->dev, ret,
+				     "failed to read calibration cell %s\n", name);
 
 	for (i = 0; i < priv->num_sensors; i++) {
 		ret = snprintf(name, sizeof(name), "s%d_p1%s", priv->sensor[i].hw_id,
@@ -117,7 +123,8 @@
 
 		ret = nvmem_cell_read_variable_le_u32(priv->dev, name, &p1[i]);
 		if (ret)
-			return ret;
+			return dev_err_probe(priv->dev, ret,
+					     "failed to read calibration cell %s\n", name);
 
 		ret = snprintf(name, sizeof(name), "s%d_p2%s", priv->sensor[i].hw_id,
 			       backup ? "_backup" : "");
@@ -126,7 +133,8 @@
 
 		ret = nvmem_cell_read_variable_le_u32(priv->dev, name, &p2[i]);
 		if (ret)
-			return ret;
+			return dev_err_probe(priv->dev, ret,
+					     "failed to read calibration cell %s\n", name);
 	}
 
 	switch (mode) {
@@ -929,7 +937,7 @@
 	.reg_stride	= 4,
 };
 
-int __init init_common(struct tsens_priv *priv)
+int init_common(struct tsens_priv *priv)
 {
 	void __iomem *tm_base, *srot_base;
 	struct device *dev = priv->dev;
