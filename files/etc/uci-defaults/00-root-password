#!/bin/sh
# 默认 root 密码（sha256-crypt 哈希）。
# 哈希由构建脚本注入：build.sh 读取 ROOT_PASSWORD 环境变量现场生成，
# CI 用 GitHub Secrets 传 ROOT_PASSWORD。本仓库不保存任何密码或哈希。
# 未注入时本脚本不做任何事（root 密码为空，请登录后自行 passwd）。
HASH='@ROOT_PASSWORD_HASH@'
[ "$HASH" = "@ROOT_PASSWORD_HASH@" ] && exit 0
grep -q "^root:$HASH:" /etc/shadow && exit 0
sed -i "s|^root:[^:]*:|root:${HASH}:|" /etc/shadow
exit 0
