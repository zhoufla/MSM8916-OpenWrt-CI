#!/bin/sh /etc/rc.common
# 等基带就绪后再初始化 QMI，避免撞上 modem 启动窗口
START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	# 必须用 &&：wait-modem 超时（基带 stalled）时不能继续发 QMI，
	# 否则回到"modem 没就绪就发 QMI -> smd_dsm_memcpy.c:297"的老路。
	# 一次性任务（执行完就退出），所以刻意不加 respawn——否则会反复重生、
	# 反复发 QMI。超时后由这里的 for 循环重试，最多 3 轮（覆盖 dog 40s 自愈窗口）。
	procd_set_param command /bin/sh -c '
		for i in 1 2 3; do
			/usr/bin/wait-modem 60 && exec /usr/bin/qmi-modem-410-init
			sleep 5
		done
		logger -t qmi-modem-410-init "基带 3 轮等待均超时，跳过 QMI 初始化"'
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	return 0
}
