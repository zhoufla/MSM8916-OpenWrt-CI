#!/bin/sh /etc/rc.common
# 等基带就绪后再做 APN 自动激活（原版无延时、带 respawn）
START=98
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	# && 而非 ;：wait-modem 超时就不要发 QMI。这个服务本身带 respawn，
	# 退出后会被重新拉起，相当于持续轮询直到基带真正就绪。
	procd_set_param command /bin/sh -c "/usr/bin/wait-modem && exec /usr/bin/qmi_auto_activate"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	echo "Stopping qmi_auto_activate monitor"
}
