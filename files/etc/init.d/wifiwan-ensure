#!/bin/sh /etc/rc.common
# wifiwan-ensure —— 首启兜底：接口真没起来时补一次 ifup
#
# 背景：msm8916 的 modem(MSS)/wcnss/wcn36xx 全是模块，wcnss 要 10s 才注册 phy0。
# netifd 在 S20 若拿不到 phy0-sta0，wifiwan 的首次 ifup 会记 NO_DEVICE 且不再重试，
# 表现为"无线已关联、WAN 没有 IPv4"。wifi-preload(S19) 已把 phy0 等到位，
# 正常情况下这里什么都不用做。
#
# 为什么只补一次：对无线接口 ifup 会触发 wifi-scripts 重新 "Preparing interface"，
# 拆掉已关联的 vif 再重建（Remove interface phy0-sta0 + deauth）。反复 ifup
# 等于自己打断自己，所以这里只做单次兜底，不循环。

START=95
STOP=10

LOG_TAG=wifiwan-ensure
IFACE=wifiwan
IFACE6=wifiwan6
LINK_WAIT=60         # 等 STA 关联的上限（秒）
SETTLE=12            # 关联成功后再给 netifd 收尾的时间（秒）
UP_WAIT=20           # ifup 后等地址的时间（秒）

log() { logger -t "$LOG_TAG" "$*"; }

iface_up() { ifstatus "$IFACE" 2>/dev/null | grep -q '"up": *true'; }
have_v4()  { ifstatus "$IFACE" 2>/dev/null | grep -q '"address": *"[0-9]'; }
sta_vif()  { iw dev 2>/dev/null | awk '$1=="Interface"{n=$2} $1=="type"&&$2=="managed"{print n; exit}'; }
linked()   { [ -n "$1" ] && iw dev "$1" link 2>/dev/null | grep -q "^Connected"; }

wait_link() {
	i=0
	while [ "$i" -lt "$LINK_WAIT" ]; do
		if linked "$(sta_vif)"; then
			log "STA associated after ${i}s"
			return 0
		fi
		i=$((i + 1))
		sleep 1
	done
	return 1
}

ensure() {
	if iface_up && have_v4; then
		log "ok: $IFACE already up"
		return 0
	fi

	# 关联完成前不 ifup，避免把 vif 拆掉重建
	if ! wait_link; then
		log "no associated STA after ${LINK_WAIT}s, skip (wifi-preload/驱动需排查)"
		return 1
	fi

	# 关联刚成功时 netifd 通常正在 setup，给它时间自己收尾；
	# 这一小段静默能避免"抢跑 -> ifup -> 拆链重建"的多余动作
	i=0
	while [ "$i" -lt "$SETTLE" ]; do
		if iface_up && have_v4; then
			log "ok: $IFACE up by netifd, $(ifstatus "$IFACE" | sed -n 's/.*"address": "\([0-9.]*\)".*/\1/p' | head -n1)"
			ifstatus "$IFACE6" 2>/dev/null | grep -q '"up": *true' || ifup "$IFACE6" >/dev/null 2>&1
			return 0
		fi
		i=$((i + 1))
		sleep 1
	done

	log "ifup $IFACE (single shot)"
	ifup "$IFACE" >/dev/null 2>&1

	i=0
	while [ "$i" -lt "$UP_WAIT" ]; do
		if iface_up && have_v4; then
			log "ok: $IFACE up, $(ifstatus "$IFACE" | sed -n 's/.*"address": "\([0-9.]*\)".*/\1/p' | head -n1)"
			ifstatus "$IFACE6" 2>/dev/null | grep -q '"up": *true' || ifup "$IFACE6" >/dev/null 2>&1
			return 0
		fi
		i=$((i + 1))
		sleep 1
	done

	log "FAILED: $IFACE has no IPv4 after ${UP_WAIT}s"
	ifstatus "$IFACE" 2>/dev/null | head -n 14 | while read -r l; do log "  $l"; done
	return 1
}

boot() { ( ensure ) >/dev/null 2>&1 & }
start() { ( ensure ) >/dev/null 2>&1 & }
stop() { :; }
