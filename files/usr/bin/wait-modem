#!/bin/sh
# 等待基带数据面就绪：wwan0 出现后再给 5 秒稳定期。
# 背景：qmi-modem-410-init / qmi_auto_activate / auto_apn 在 S98/S99（DELAY=0）
# 立刻发 QMI，正好撞上 modem 初始化窗口，导致 modem 侧
# fatal error received: smd_dsm_memcpy.c:297 并重启。
MAX=${1:-60}
i=0
while [ "$i" -lt "$MAX" ]; do
	[ -e /sys/class/net/wwan0 ] && break
	sleep 1
	i=$((i + 1))
done
[ -e /sys/class/net/wwan0 ] || exit 1
sleep 5
exit 0
