#!/bin/sh
# modem-recover —— msm8916 基带开机兜底（主动重启代替死等 40s 看门狗）
#
# 背景：本板的 MPSS 冷启动有一定概率在 "is now up" 之后零进展，主机侧看到的就是
#   - remoteproc state = running（modem 已 assert ready）
#   - 但 wwan0 / at0 / qmi0 一个都不出现，rmtfs 收不到任何请求
#   - 直到 modem 内部看门狗（dog.c）在 40s 后报 stalled initialization，驱动才重启
# 连续崩 5 次 → 开机到可用能拖到 3 分钟以上。
#
# 本脚本在基带 running 之后盯 `-w` 秒，端口没出现就主动 stop/start，
# 把单次恢复从 40s+ 压到约 10s。等价于安卓侧 subsystem_restart 的隐式行为。
#
# 用法:
#   modem-recover [-n 最大尝试次数] [-w 每次等待秒数] [-p 端口名] [-q]
#     -n 3    最多主动重启 3 次（默认 3，0 = 只观测不动作）
#     -w 12   每轮等待端口出现的秒数（默认 12）
#     -p wwan0 端口名（默认 wwan0，bam-dmux 会建 wwan0..wwan7）
#     -q      静默（只写 syslog）
#
# 退出码: 0 = 端口正常（含重启后恢复）/ 1 = 用尽尝试仍无端口
# 幂等: 只做"重启 mss"，不修改任何持久配置；重复执行无副作用。

set -u

TRIES=3
WAIT=12
PORT=wwan0
QUIET=0

while [ $# -gt 0 ]; do
	case "$1" in
	-n) TRIES=$2; shift 2 ;;
	-w) WAIT=$2; shift 2 ;;
	-p) PORT=$2; shift 2 ;;
	-q) QUIET=1; shift ;;
	-h|--help) sed -n '2,28p' "$0"; exit 0 ;;
	*) echo "未知参数: $1" >&2; exit 2 ;;
	esac
done

log() {
	[ "$QUIET" = 1 ] && { logger -t modem-recover "$*" 2>/dev/null; return; }
	if command -v logger >/dev/null 2>&1; then
		logger -t modem-recover "$*"
	fi
	echo "modem-recover: $*"
}

# 找 mss 对应的 remoteproc（名字形如 4080000.remoteproc，个别内核叫 mpss）
find_rproc() {
	for d in /sys/class/remoteproc/remoteproc*; do
		[ -r "$d/name" ] || continue
		case "$(cat "$d/name" 2>/dev/null)" in
		4080000*|mpss*) echo "$d"; return 0 ;;
		esac
	done
	return 1
}

port_ok() { [ -e "/sys/class/net/$PORT" ]; }

RP=$(find_rproc) || { log "没有找到 mss remoteproc，跳过"; exit 0; }
STATE_F="$RP/state"

# 等发行版自己的服务把它拉起来（OpenWrt init 脚本 / Debian soc-qcom-*-rproc）
i=0
while [ "$i" -lt 20 ]; do
	[ "$(cat "$STATE_F" 2>/dev/null)" = "running" ] && break
	sleep 1
	i=$((i + 1))
done

if [ "$(cat "$STATE_F" 2>/dev/null)" != "running" ]; then
	log "基带未 running（state=$(cat "$STATE_F" 2>/dev/null)），尝试 start"
	echo start > "$STATE_F" 2>/dev/null || log "start 写入失败"
	sleep 3
	if [ "$(cat "$STATE_F" 2>/dev/null)" != "running" ]; then
		log "start 未生效，交给驱动/看门狗，退出"
		exit 1
	fi
fi

if [ "$TRIES" -eq 0 ]; then
	log "仅观测模式：state=running 已确认，不再介入"
	exit 0
fi

n=1
while [ "$n" -le "$TRIES" ]; do
	t=0
	while [ "$t" -lt "$WAIT" ]; do
		if port_ok; then
			[ "$n" -eq 1 ] && log "基带正常（$PORT 在第 ${t}s 出现）" \
				|| log "重启后恢复：$PORT 出现（第 $n 轮，+${t}s）"
			exit 0
		fi
		sleep 1
		t=$((t + 1))
	done

	log "第 $n/${TRIES} 轮：${WAIT}s 内没有 $PORT（疑似 stalled init），主动重启 mss"
	echo stop > "$STATE_F" 2>/dev/null
	sleep 2

	if [ "$(cat "$STATE_F" 2>/dev/null)" = "running" ]; then
		# stop 没落地：多半是驱动已经在处理 crash，别和它抢
		log "stop 未生效（驱动可能正在恢复），放弃本轮"
		exit 0
	fi

	echo start > "$STATE_F" 2>/dev/null
	sleep 3
	n=$((n + 1))
done

log "已尝试 $TRIES 次仍无 $PORT，交给内核看门狗"
exit 1
